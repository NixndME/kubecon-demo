          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "GPU temperature",
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
