    {
      "id": 17,
      "type": "stat",
      "title": "GPU power",
      "gridPos": {
        "x": 20,
        "y": 13,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
